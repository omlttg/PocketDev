# --- Gemini API Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Telegram Bot Configuration ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of Telegram User IDs allowed to interact with the bot
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# Telegram Group Chat ID for team task notifications (usually starts with a minus sign)
TELEGRAM_GROUP_CHAT_ID=-100123456789

# --- GitLab API Configuration ---
# If self-hosting GitLab, change this URL. Defaults to https://gitlab.com
GITLAB_URL=https://gitlab.com
GITLAB_PERSONAL_ACCESS_TOKEN=your_gitlab_personal_access_token_here
# Numeric ID or URL-encoded path of the GitLab Project to manage
GITLAB_PROJECT_ID=your_gitlab_project_id_here

# --- GitLab MCP Server Configuration ---
# Set to True to route GitLab tools through an external GitLab MCP Server
USE_MCP_SERVER=False
# The endpoint URL of the GitLab MCP Server (HTTP/SSE transport)
MCP_SERVER_URL=http://localhost:8001

# --- Server Configuration ---
PORT=8000
HOST=0.0.0.0
# Secret alphanumeric token to secure Telegram webhook requests (generate randomly)
WEBHOOK_SECRET_TOKEN=my_super_secret_webhook_token_123
