# --- Cấu hình Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Cấu hình Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Danh sách Telegram User ID được phép tương tác với bot, phân cách bởi dấu phẩy
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# Telegram Group Chat ID for team task notifications (usually starts with a minus sign)
TELEGRAM_GROUP_CHAT_ID=-100123456789

# --- Cấu hình GitLab API ---
# Nếu tự host GitLab, thay đổi URL này. Mặc định là https://gitlab.com
GITLAB_URL=https://gitlab.com
GITLAB_PERSONAL_ACCESS_TOKEN=your_gitlab_personal_access_token_here
# ID của Project GitLab cần bot quản lý (có thể tìm thấy trên trang chủ project)
GITLAB_PROJECT_ID=your_gitlab_project_id_here

# --- Cấu hình Server ---
PORT=8000
HOST=0.0.0.0
# Token bí mật để bảo vệ Webhook Telegram (tự đặt ngẫu nhiên)
WEBHOOK_SECRET_TOKEN=my_super_secret_webhook_token_123
